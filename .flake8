; source: https://github.com/ament/ament_lint/blob/humble/ament_flake8/ament_flake8/configuration/ament_flake8.ini
[flake8]
extend-ignore = B902,C816,D100,D101,D102,D103,D104,D105,D106,D107,D203,D212,D404,I202,Q000,I100,I101,I201,A001,A002,C417,D400
import-order-style = google
max-line-length = 99
show-source = true
statistics = true
